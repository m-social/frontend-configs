{
	"name": "@m-social/eslint-config-svelte",
	"version": "2.0.0",
	"description": "Shared ESLint config for Svelte used by M-Social projects",
	"keywords": [
		"eslint",
		"eslint-config",
		"m-social",
		"svelte",
		"sveltekit"
	],
	"license": "MIT",
	"author": {
		"name": "M-Social",
		"url": "https://msocialproduction.com"
	},
	"contributors": [
		{
			"name": "Artem Pitikin",
			"email": "a.pitikin@msocialproduction.com"
		}
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/m-social/frontend-configs.git",
		"directory": "configs/eslint/svelte"
	},
	"files": [
		"dist",
		"src"
	],
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.cts",
	"exports": {
		".": {
			"@m-social/frontend-configs": "./src/index.ts",
			"types": {
				"import": "./dist/index.d.mts",
				"require": "./dist/index.d.cts"
			},
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown"
	},
	"dependencies": {
		"@eslint/js": "^10.0.1",
		"eslint-plugin-svelte": "^3.17.0",
		"globals": "catalog:production",
		"typescript-eslint": "catalog:production"
	},
	"devDependencies": {
		"eslint": "catalog:development"
	},
	"peerDependencies": {
		"eslint": "catalog:production"
	}
}
