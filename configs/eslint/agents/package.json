{
	"name": "@m-social/eslint-plugin-agents",
	"version": "0.0.0",
	"description": "ESLint rules that keep AI coding agents within the code conventions of M-Social projects",
	"keywords": [
		"agents",
		"ai",
		"eslint",
		"eslint-plugin",
		"eslintplugin",
		"m-social",
		"react"
	],
	"license": "MIT",
	"author": {
		"name": "M-Social",
		"url": "https://msocialproduction.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/m-social/frontend-configs.git",
		"directory": "configs/eslint/agents"
	},
	"files": [
		"dist",
		"docs",
		"src"
	],
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.cts",
	"exports": {
		".": {
			"@m-social/frontend-configs": "./src/index.ts",
			"types": {
				"import": "./dist/index.d.mts",
				"require": "./dist/index.d.cts"
			},
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown"
	},
	"dependencies": {
		"@eslint-community/eslint-plugin-eslint-comments": "^4.8.1"
	},
	"devDependencies": {
		"eslint": "catalog:development"
	},
	"peerDependencies": {
		"eslint": "catalog:production"
	}
}
