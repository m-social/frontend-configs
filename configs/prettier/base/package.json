{
	"name": "@m-social/prettier-config",
	"version": "2.1.0",
	"description": "Base Prettier config used internally at M-Social",
	"keywords": [
		"config",
		"m-social",
		"prettier",
		"prettier-config"
	],
	"license": "MIT",
	"author": {
		"name": "M-Social",
		"url": "https://msocialproduction.com"
	},
	"contributors": [
		{
			"name": "Artem Pitikin",
			"email": "a.pitikin@msocialproduction.com"
		}
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/m-social/frontend-configs.git",
		"directory": "configs/prettier/base"
	},
	"files": [
		"dist",
		"src"
	],
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.cts",
	"exports": {
		".": {
			"@m-social/frontend-configs": "./src/index.ts",
			"types": {
				"import": "./dist/index.d.mts",
				"require": "./dist/index.d.cts"
			},
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown"
	},
	"dependencies": {
		"@ianvs/prettier-plugin-sort-imports": "^4.7.1",
		"@prettier/plugin-oxc": "^0.1.3"
	},
	"devDependencies": {
		"@m-social/prettier-config-utils": "workspace:*"
	},
	"peerDependencies": {
		"prettier": "catalog:production"
	}
}
