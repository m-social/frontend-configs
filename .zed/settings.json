// Folder-specific settings
//
// For a full list of overridable settings, and general information on folder-specific settings,
// see the documentation: https://zed.dev/docs/configuring-zed#settings-files
{
	"lsp": {
		"oxlint": {
			"initialization_options": {
				"settings": {
					"configPath": null,
					"typeAware": true,
					"fixKind": "safe_fix_or_suggestion",
					"unusedDisableDirectives": "warn"
				}
			}
		},

		"oxfmt": {
			"initialization_options": {
				"settings": {
					"fmt.configPath": null,
					"run": "onSave"
				}
			}
		}
	},
	"languages": {
		"JavaScript": {
			"format_on_save": "on",
			"prettier": {
				"allowed": false
			},
			"formatter": { "language_server": { "name": "oxfmt" } },

			"code_actions_on_format": {
				"source.fixAll.oxfmt": true
			}
		},

		"TypeScript": {
			"format_on_save": "on",
			"prettier": {
				"allowed": false
			},
			"formatter": { "language_server": { "name": "oxfmt" } },

			"code_actions_on_format": {
				"source.fixAll.oxfmt": true
			}
		},

		"JSON": {
			"format_on_save": "on",
			"prettier": {
				"allowed": false
			},
			"formatter": { "language_server": { "name": "oxfmt" } }
		},
		"JSONC": {
			"format_on_save": "on",
			"prettier": {
				"allowed": false
			},
			"formatter": { "language_server": { "name": "oxfmt" } }
		},

		"Markdown": {
			"format_on_save": "on",
			"prettier": {
				"allowed": false
			},
			"formatter": { "language_server": { "name": "oxfmt" } }
		},

		"YAML": {
			"format_on_save": "on",
			"prettier": {
				"allowed": false
			},
			"formatter": [
				{
					"language_server": {
						"name": "oxfmt"
					}
				}
			]
		}
	}
}
